# Copy to .env and set local-only paths/endpoints. Never commit .env.
LUNA_BASE_URL=http://127.0.0.1:10100/v1
LUNA_MODEL=codeen/gpt-6-luna
MOBILE_DEVICE_ID=your-local-booted-ios-simulator-udid
MOBILE_MCP_COMMAND=/path/to/project/node_modules/.bin/mcp-server-mobile
CLEF_PYTHON=/path/to/clef-python/bin/python
CLEF_BRIDGE=/path/to/project/clef_bridge.py
CLEF_MODEL_DIR=/path/to/CLEF-Flash/model
PAIRED_TRIALS=3
BENCHMARK_RESULTS_PATH=benchmark-results/local-results.json
